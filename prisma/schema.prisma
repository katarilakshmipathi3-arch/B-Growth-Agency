datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String        @id @default(uuid())
  name               String
  email              String        @unique
  password           String
  role               String        @default("SUPER_ADMIN") // SUPER_ADMIN, EDITOR
  mustChangePassword Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  activityLogs       ActivityLog[]
}

model Service {
  id               String   @id @default(uuid())
  slug             String   @unique
  title            String
  category         String   // Web Development, Poster & Graphic Design, Video Editing, Branding, Social Media, SEO
  coverImage       String
  gallery          String   @default("[]") // JSON string of image URLs
  shortDescription String
  fullDescription  String
  features         String   @default("[]") // JSON string of string features
  deliverables     String   @default("[]") // JSON string of deliverables
  pricingTiers     String   @default("[]") // JSON string of {name, price, currency, features, isPopular}
  startingPrice    Float    @default(0)
  icon             String   @default("Sparkles")
  isFeatured       Boolean  @default(false)
  order            Int      @default(0)
  status           String   @default("published") // published, draft
  seoTitle         String?
  seoDescription   String?
  isDemo           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PortfolioItem {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  type           String   // "Website", "Poster Design", "Edited Video"
  category       String
  clientName     String
  thumbnail      String
  images         String   @default("[]") // JSON string array
  videoUrl       String?
  liveUrl        String?
  description    String
  challenge      String?
  solution       String?
  results        String?
  toolsUsed      String   @default("[]") // JSON array of tool names
  completionDate String?
  isFeatured     Boolean  @default(false)
  tags           String   @default("[]") // JSON array
  order          Int      @default(0)
  status         String   @default("published") // published, draft
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Inquiry {
  id              String   @id @default(uuid())
  type            String   @default("contact") // contact, quote
  name            String
  email           String
  phone           String?
  serviceInterest String?
  budget          String?
  timeline        String?
  message         String
  details         String?  // JSON string for multi-step quote answers
  status          String   @default("New") // New, In Progress, Closed
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  status    String   @default("active") // active, unsubscribed
  createdAt DateTime @default(now())
}

model Testimonial {
  id         String   @id @default(uuid())
  clientName String
  clientRole String
  company    String
  avatar     String?
  content    String
  rating     Int      @default(5)
  isFeatured Boolean  @default(true)
  order      Int      @default(0)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ClientLogo {
  id         String   @id @default(uuid())
  name       String
  logoUrl    String
  websiteUrl String?
  order      Int      @default(0)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model TeamMember {
  id        String   @id @default(uuid())
  name      String
  role      String
  avatar    String
  bio       String
  socials   String   @default("{}") // JSON string: {linkedin, twitter, github, dribbble}
  order     Int      @default(0)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model BlogPost {
  id             String   @id @default(uuid())
  slug           String   @unique
  title          String
  coverImage     String
  excerpt        String
  content        String
  category       String
  readTime       String   @default("5 min read")
  authorName     String   @default("B Growth Team")
  authorAvatar   String?
  status         String   @default("published") // published, draft
  publishedAt    DateTime @default(now())
  seoTitle       String?
  seoDescription String?
  isDemo         Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String   @default("General")
  order     Int      @default(0)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PageContent {
  id        String   @id @default(uuid())
  key       String   @unique // home, about, contact, etc.
  data      String   // JSON string
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model MediaFile {
  id           String   @id @default(uuid())
  filename     String
  originalName String
  url          String
  mimeType     String
  size         Int
  createdAt    DateTime @default(now())
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  userName   String   @default("Admin")
  action     String   // CREATE, UPDATE, DELETE, LOGIN
  entityType String   // Service, Portfolio, User, etc.
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model ClientPortal {
  id                 String                @id @default(uuid())
  clientName         String
  clientEmail        String
  company            String
  token              String                @unique // unique secure slug for client access
  accessPin          String?
  projectName        String
  serviceType        String                // Web Development, Poster Design, Video Editing, Full Stack
  status             String                @default("In Progress") // Discovery, Design, Development, QA & Polish, Completed
  progress           Int                   @default(25) // 0-100%
  startDate          String?
  deliveryDate       String?
  stagingUrl         String?
  figmaUrl           String?
  videoProofUrl      String?
  milestones         String                @default("[]") // JSON: [{id, title, desc, status, date}]
  deliverables       String                @default("[]") // JSON: [{id, name, type, fileUrl, status}]
  agencyContactName  String                @default("Adharsh Katari")
  agencyContactRole  String                @default("Founder · B Growth Agency")
  agencyContactPhone String                @default("+91 98765 43210")
  agencyContactEmail String                @default("adharsh@bgrowth.agency")
  expiresAt          DateTime?
  isActive           Boolean               @default(true)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  messages           ClientPortalMessage[]
  invoices           Invoice[]
}

model ClientPortalMessage {
  id            String       @id @default(uuid())
  portalId      String
  sender        String       // "CLIENT" or "AGENCY"
  senderName    String
  message       String
  attachmentUrl String?
  createdAt     DateTime     @default(now())
  portal        ClientPortal @relation(fields: [portalId], references: [id], onDelete: Cascade)
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  clientName    String
  clientEmail   String
  clientCompany String
  clientAddress String?
  portalId      String?
  date          String
  dueDate       String
  items         String        @default("[]") // JSON: [{description, quantity, rate, amount}]
  subtotal      Float         @default(0)
  taxRate       Float         @default(18.0)
  taxAmount     Float         @default(0)
  discount      Float         @default(0)
  total         Float         @default(0)
  status        String        @default("PENDING") // PAID, PENDING, OVERDUE, DRAFT
  paymentNotes  String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  portal        ClientPortal? @relation(fields: [portalId], references: [id], onDelete: SetNull)
}

model Contract {
  id              String    @id @default(uuid())
  contractNumber  String    @unique
  title           String
  clientName      String
  clientEmail     String
  clientCompany   String
  serviceScope    String
  totalValue      Float     @default(0)
  paymentSchedule String    @default("50% upfront deposit, 50% upon final signoff and delivery")
  deliverables    String    @default("[]")
  terms           String
  status          String    @default("SENT") // SENT, ACCEPTED, SIGNED, EXPIRED
  signedAt        DateTime?
  signatureName   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}
